{
  "name": "ppagent",
  "version": "0.1.0",
  "description": "为本地部署模型设计的 coding agent harness",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:src && npm run build:bin",
    "build:src": "tsc -p tsconfig.json",
    "build:bin": "tsc -p tsconfig.bin.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "depcruise": "depcruise src bin test --config .dependency-cruiser.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fish0710/ppagent.git"
  },
  "license": "ISC",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.7.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
